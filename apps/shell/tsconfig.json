{
 "compilerOptions":{
   "target":"ES2020",
   "lib":[
     "DOM",
     "DOM.Iterable",
     "ES2020"
   ],

   "allowJs":false,

   "skipLibCheck":true,

   "esModuleInterop":true,

   "allowSyntheticDefaultImports":true,

   "strict":true,

   "noEmit":true,

   "jsx":"react-jsx",

   "baseUrl": ".",
   "ignoreDeprecations": "6.0",
    "paths": {
      "@app/*": [
        "src/app/*"
      ],
      "@shared/*": [
        "src/shared/*"
      ],
      "@features/*": [
        "src/features/*"
      ],
      "@pages/*": [
        "src/pages/*"
      ],
      "@providers/*": [
        "src/providers/*"
      ],
      "@routes/*": [
        "src/routes/*"
      ],
      "@assets/*": [
        "src/assets/*"
      ]
    }
 },

 "include":[
   "src"
 ]
}