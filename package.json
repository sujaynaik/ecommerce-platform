{
  "name": "ecommerce-platform",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "check": "pnpm format:check && pnpm --filter @commerce/shell typecheck && pnpm build",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:all": "pnpm check && pnpm check:runtime",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean",
    "storybook": "pnpm --filter @commerce/ui storybook",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "dotenv": "^17.4.2",
    "prettier": "^3.9.6"
  }
}
