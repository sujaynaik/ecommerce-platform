# Shared local defaults
NODE_ENV=development

# REST API
PORT=4000
DATABASE_URL=postgresql://commerce:commerce@localhost:5432/commerce
DATABASE_POOL_MAX=10
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-refresh-secret-at-least-32-characters
ACCESS_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# Frontend
API_BASE_URL=http://localhost:4000
APP_NAME=Commerce Operations
PRODUCTS_REMOTE_URL=http://localhost:3001/remoteEntry.js
ORDERS_REMOTE_URL=http://localhost:3002/remoteEntry.js
USERS_REMOTE_URL=http://localhost:3003/remoteEntry.js
